# Production configuration. Copy to .env.production on the server (never commit it) and fill in.
# Used both for compose interpolation (--env-file) and as the backend containers' env_file.
#
# Generate secrets on the server:
#   openssl rand -hex 32      → passwords (hex only: they are embedded in connection URLs)
#   openssl rand -base64 32   → STORAGE_CREDENTIALS_KEY (must be exactly 32 bytes)
#   openssl rand -base64 48   → JWT_ACCESS_SECRET

# ── Public site (Caddy) ───────────────────────────────────────────────────────
SITE_ADDRESS=dms.example.com
ACME_EMAIL=it@example.com
# Upstream proxies trusted to report the real client IP. The default trusts none. Behind
# Cloudflare's proxy (orange cloud) set this to Cloudflare's ranges from
# https://www.cloudflare.com/ips/ (space-separated). Leave as-is for DNS-only / no Cloudflare.
TRUSTED_PROXIES=127.0.0.1/32

# ── Database / Redis (internal to the Docker network; no published ports) ─────
POSTGRES_USER=dms
POSTGRES_PASSWORD=
POSTGRES_DB=dms
REDIS_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=https://dms.example.com
FRONTEND_URL=https://dms.example.com

# Encrypts saved storage credentials. Back this up somewhere safe: if it's lost, every saved
# storage configuration must be re-entered. Changing it has the same effect.
STORAGE_CREDENTIALS_KEY=

# Signs access tokens. Changing it signs everyone out (refresh tokens still work after re-login).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 120 MiB. If the site is behind Cloudflare's proxy, its plan caps request bodies (100 MB on
# Free/Pro — check your plan): either serve DNS-only or lower this below that cap.
MAX_UPLOAD_BYTES=125829120
OCR_MAX_PAGES=50

# ── Email (Brevo) — the sender domain must be verified in Brevo ───────────────
MAIL_DISABLED=false
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=DMS

# ── Backups (deploy/backup) ───────────────────────────────────────────────────
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAYS=14
# Optional off-server copy to an S3-compatible bucket (e.g. a separate Cloudflare R2 bucket).
# Use a bucket and API token separate from document storage, scoped to that bucket only.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dms
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ── Ports (change only for a local smoke test) ────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
