# Postgres (used by docker-compose.yml and by the backend's DATABASE_URL below)
POSTGRES_USER=dms
POSTGRES_PASSWORD=dms
POSTGRES_DB=dms
# Note: 5433, not the Postgres default 5432 — avoids clashing with a locally installed
# Postgres instance also listening on 5432 on the host. Change if 5433 is taken too.
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Backend
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dms:dms@localhost:5433/dms
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# true only behind a reverse proxy that sanitises X-Forwarded-For (Caddy in production)
TRUST_PROXY=false

# Storage — credentials in storage_config are encrypted at rest with this key. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_CREDENTIALS_KEY=
# Optional in development (any NAS path is accepted when unset); required for NAS in production.
# STORAGE_NAS_ROOT=
# Extra S3-compatible hosts allowed besides *.r2.cloudflarestorage.com, comma-separated.
# STORAGE_R2_ALLOWED_HOSTS=

# Auth — JWT_ACCESS_SECRET MUST be a long random value in production (this is a dev placeholder)
JWT_ACCESS_SECRET=dev-only-change-me-for-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Distributed guessing: past this many failures on one account (all IPs), only IPs it signed in from
# in the last LOGIN_TRUSTED_IP_DAYS may still try (SECURITY_AUDIT.md M-3).
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=50
LOGIN_TRUSTED_IP_DAYS=30

# Upload & OCR (Module 6). MAX_UPLOAD_BYTES defaults to 120MB (margin above the 100MB target,
# UPL-7). OCR_MAX_PAGES caps how many PDF pages the OCR worker will process so an oversized scan
# never stalls the queue. MAIL_DISABLED=true suppresses all outbound mail (use for test runs so
# invitation/verification tests don't bounce real Brevo sends).
MAX_UPLOAD_BYTES=125829120
OCR_MAX_PAGES=50
# Image OCR (Tesseract) is off unless set to true. PDF text extraction runs either way.
OCR_IMAGES_ENABLED=false
MAIL_DISABLED=false

# Retention (PRD v1.2 RET-3). The retention worker (`npm run worker:retention --workspace backend`)
# runs once a day at this local time: auto-delete moves expired documents to Trash, then the
# automatic Trash purge permanently removes items older than 30 days. Legal Holds stop both.
# Each organization's own time zone decides what "today" is for its documents.
RETENTION_JOB_TIME=02:00
RETENTION_JOB_TIME_ZONE=Asia/Kolkata

# Email — Brevo. Leave BREVO_API_KEY blank to fall back to console-logged "emails" (dev mode).
# noreply@abateas.app must be a verified sender/domain in the Brevo account, or sends will fail.
BREVO_API_KEY=
EMAIL_FROM=noreply@abateas.app
EMAIL_FROM_NAME=Edoc

# Frontend (Vite exposes only VITE_-prefixed vars to client code)
VITE_API_URL=http://localhost:4000

# Uploads are held in memory whole; these bound it (SECURITY_AUDIT.md M-5). Over the limit -> 429, retry.
# MAX_CONCURRENT_UPLOADS=8
# MAX_CONCURRENT_UPLOADS_PER_USER=2
