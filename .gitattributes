# Files executed or parsed inside Linux containers must keep LF endings even on a Windows checkout
# (core.autocrlf=true would otherwise turn them into CRLF and break the shebang / Caddy parser).
*.sh        text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
